digraph {
rankdir=TB;
State_Undefined [shape="circle" color="black" style="filled" label=""];
State_Final [shape="circle" label="X"];
{%- for state in chart.states %}
{%- set label = 'on_entry / ' | dot_action('\\n', state.on_entry) + 'on_cycle / ' | dot_action('\\n', state.on_cycle) + 'on_exit /' | dot_action('\\n', state.on_exit) %}
State_{{state.in}} [shape=Mrecord label="{State::{{state.in}} | {{label}} }"];
{%- endfor %}
{# === #}
State_Undefined -> State_{{chart.entry}} [label="{{'always / ' | dot_action('\\n', chart.enter)}}"];
{# === #}
{%- for state in chart.states %}
{%- for substate in state.states %}
{%- for transition in substate.transitions %}
{%- set label = '' | dot_action('', transition.trigger) + ' ' + '' | dot_action('', transition.guard) + '\n' + '' | dot_action('', transition.block) %}
State_{{substate.in}} -> State_{{transition.target}} [label="{{label}}"];
{%- endfor %}
{%- endfor %}
{%- endfor %}
}