{{ ClassName }}::Ordinal {{ ClassName }}::OnGuard(State state) const {
    {{ ClassName }}::Ordinal ordinal = 0; // zero means to stay in the current state
    switch (state) {
    {%- for state in chart.states %}
        case State::{{state.in}}:
        {%- for transition in state.transitions %}{%- filter indent(width=12) %} {{ cpp_trigger(transition.trigger) }} {%- endfilter %} {%- filter indent(width=16) %}{{ cpp_guard(interface, transition.guard) }} {%- endfilter %}
                    ordinal = {{loop.index}};
                    break;
                }
            }
        {%- endfor %}
            break;
    {%- endfor %}
        default:
            // Undefined or Final is not allowed!
            break;
    }
    // we clear the input here after all guards have been evaluated
    // it must be triggered again to be seen
    input_.Clear();
    // zero indicates that no transition was taken
    return ordinal;
}

State {{ ClassName }}::OnTransition(State from, {{ClassName}}::Ordinal ordinal) {
    if (ordinal == 0U) {
        // not allowed
        return State::Undefined;
    }
    switch (from) {
        case State::Undefined: // ordinal is ignored here
            return State::{{chart.entry}};
    {%- for state in chart.states %}
        case State::{{state.in}}:
        {%- for transition in state.transitions %}
            if (ordinal == {{loop.index}}) {
            {%- filter indent(width=16) %}
            {%- if transition.block %} {{ cpp_action(interface, transition.block) }}
            {%- endif %}
            {%- endfilter %}
                return State::{{transition.target}};
            }
        {%- endfor %}
            break;
    {%- endfor %}
        default:
            // Undefined or Final is not allowed!
            break;
    }
    // if the state not take, return from where you came
    return from;
}

