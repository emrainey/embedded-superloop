{{ ClassName }}::Ordinal {{ ClassName }}::OnGuard(State state) const {
    {{ ClassName }}::Ordinal ordinal = 0;
    switch (state) {
        {%- for state in chart.states %}
        case State::{{state.in}}:
            {%- for transition in state.transitions %}
            {%- if transition.trigger.input %}
            if (input_.IsRaised() and input_.Peek() == Inputs::{{transition.trigger.input}}) {
                input_.Clear();
            {%- elif transition.trigger.condition %}
            if ({{transition.trigger.condition}}) {
            {%- elif transition.trigger == 'always' %}
            // No trigger, immediate transition
            if (true) {
            {%- else %}
            #error We do not know what {{transition.trigger}} means
            if (false) { // should never happen
            {%- endif %}
            {%- if transition.guard.interface %}
                if (callback_.{{transition.guard.interface}}()) {
            {%- elif transition.guard.condition %}
                if ({{transition.guard.condition}}) {
            {%- elif transition.guard == 'true' or transition.guard == 'None' %}
                // No guard, always true
                if (true) {
            {%- else %}
                #error We do not know what {{transition.guard}} means
                if (false) { // should never happen
            {%- endif %}
                    ordinal = {{loop.index}};
                    break;
                }
            }
            {%- endfor %}
            break;
        {%- endfor %}
        default:
            // Undefined or Final is not allowed!
            break;
    }
    // zero indicates that no transition was taken
    return ordinal;
}

State {{ ClassName }}::OnTransition(State from, Ordinal ordinal) {
    if (ordinal == 0U) {
        // not allowed
        return State::Undefined;
    }
    switch (from) {
        case State::Undefined: // ordinal is ignored here
            return State::{{chart.entry}};
        {%- for state in chart.states %}
        case State::{{state.in}}:
            {%- for transition in state.transitions %}
            if (ordinal == {{loop.index}}) {
                // TODO add capability to run out of State logic like choices, etc.
                return State::{{transition.target}};
            }
            {%- endfor %}
            break;
        {%- endfor %}
        default:
            // Undefined or Final is not allowed!
            break;
    }
    // if the state not take, return from where you came
    return from;
}

