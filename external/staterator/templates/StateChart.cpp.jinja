{%- endfor %}
{%- for countdown in countdowns %}
    , {{countdown.name}}{clock_, MicroSeconds{ {{countdown.duration_ms}} } } ///< {{countdown.description}}
{%- endfor %}
{%- for state in states %}
{%- if state.states %}
    , {{state.name|lower}}_{ *this, State::{{state.name}} } ///< The SubState instance for {{state.name}}
{%- endif %}
{%- endfor %}
    {}

void {{ ClassName }}::Trigger(Inputs event) {
    output_ = Outputs::None; // lower any outputs in preparation for the next one
    input_ = event;
    RunOnce();
    if (output_.Peek() != Outputs::None) {
        callback_.OnOutput(std::move(output_));
    }
    // input is cleared in OnGuard after all guards have been evaluated
}

core::Event<Outputs> const& {{ ClassName }}::GetOutput() const {
    return output_;
}

