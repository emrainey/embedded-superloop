{%- endfor %}
    {}

void {{ ClassName }}::Trigger(Inputs event) {
    output_ = Outputs::None; // lower any outputs in preparation for the next one
    input_ = event;
    RunOnce();
    if (output_.Peek() != Outputs::None) {
        callback_.OnOutput(std::move(output_));
    }
    input_ = Inputs::None; // reset the input after processing
}

core::Event<Outputs> const& {{ ClassName }}::GetOutput() const {
    return output_;
}

