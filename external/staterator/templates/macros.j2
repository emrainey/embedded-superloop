{%- macro cpp_action(interface, action) %}
// cpp_action(interface, {{action}})
{%- if action == 'None' %}
// do nothing
{%- else %}
{%- if action.expression %}
{{action.expression|replace_bools}};
{%- endif %}
{%- if action.output %}
output_ = Outputs::{{action.output}};
{%- endif %}
{%- if action.call %}
{%- set interface_call = '' | on_interface_call(interface, action.call) %}
{{interface_call}};
{%- endif %}
{%- endif %}
{%- endmacro %}

