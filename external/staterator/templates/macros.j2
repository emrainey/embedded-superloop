{%- macro uml_state(state) %}
{%- set on_entry = 'entry / ' | dot_action('', state.on_entry) %}
{{state.in}} : {{ on_entry }}
{%- set on_cycle = 'cycle / ' | dot_action('', state.on_cycle) %}
{{state.in}} : {{ on_cycle }}
{%- set on_exit = 'exit / ' | dot_action('', state.on_exit) %}
{{state.in}} : {{ on_exit }}
{%- for transition in state.transitions %}
{%- set label = '' | dot_action('', transition.trigger) + ' ' + '' | dot_action('', transition.guard) + '\\n' | dot_action('', transition.block) %}
{{state.in}} --> {{ transition.target | final_filter }} : {{ label }}
{%- endfor %}
{%- endmacro %}

{%- macro uml_recursive_states(state, width) %}
state {{ state.in }} {
{%- filter indent(width) %}
{%- set on_entry = 'entry / ' | dot_action('', state.on_entry) %}
{{ state.in }} : {{ on_entry }}
{%- set on_cycle = 'cycle / ' | dot_action('', state.on_cycle) %}
{{ state.in }} : {{ on_cycle }}
{%- set on_exit = 'exit / ' | dot_action('', state.on_exit) %}
{{ state.in }} : {{ on_exit }}
[*] --> {{ state.entry }}
{%- for substate in state.states %}
{%- if substate.states %}
{{ uml_recursive_states(substate, width + 4) }}
{%- else %}
{{ uml_state(substate) }}
{%- endif %}
{%- endfor %}
{%- endfilter %}
}
{%- endmacro %}

