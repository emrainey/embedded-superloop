{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "lsp": "allow",
        "mcp": "allow"
    },
    "lsp": {
        "clangd": {
            "command": [
                "clangd",
                "--compile-commands-dir=build/native-llvm",
                "--background-index",
                "--query-driver=/**/arm-none-eabi-*",
                "--clang-tidy",
                "--enable-config",
                "--header-insertion=iwyu",
                "--pretty"
            ]
        }
    },
    "mcp": {
        "pylink-square-mcp": {
            "type": "local",
            "command": [
                ".venv/bin/python",
                "tools/pylink-square-mcp/mcp_server.py"
            ],
            "cwd": ".",
            "environment": {
                "PYTHONPATH": "tools/pylink-square-mcp"
            }
        },
        "pdf-oxide-mcp": {
            "type": "local",
            "command": [
                "pdf-oxide-mcp"
            ],
            "cwd": "documentation/pdfs"
        }
    }
}
