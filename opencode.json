{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "lsp": "allow",
        "mcp": "allow"
    },
    "lsp": {
        "clangd": {
            "command": [
                "clangd",
                "--background-index"
            ]
        }
    },
    "mcp": {
        "pylink-square-mcp": {
            "type": "local",
            "command": [
                ".venv/bin/python",
                "tools/pylink-square-mcp/mcp_server.py"
            ],
            "cwd": ".",
            "environment": {
                "PYTHONPATH": "tools/pylink-square-mcp"
            }
        },
        "pdf-oxide-mcp": {
            "type": "local",
            "command": [
                "pdf-oxide-mcp"
            ],
            "cwd": "documentation/pdfs",
        }
    }
}