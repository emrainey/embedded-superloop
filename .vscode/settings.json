    "clang.cxxflags": [
        "-std=c++20",
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-threadsafe-statics",
        "-fno-use-cxa-atexit"
    ],
    "clang.cflags": [
        "-std=c23",
    ],
    "cmake.allowCommentsInPresetsFile": true,
    "cmake.allowUnsupportedPresetsVersions": true,
    "cmake.buildEnvironment": {
        "CMAKE_VERBOSE": "0"
    },
    "cmake.configureArgs": [
