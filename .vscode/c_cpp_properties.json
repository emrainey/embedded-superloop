{
    "env": {
        "DefaultIncludePaths": [
            "${workspaceFolder}/include",
            "${workspaceFolder}/modules/core/include",
            "${workspaceFolder}/modules/cortex/include",
            "${workspaceFolder}/modules/jarnax/include",
            "${workspaceFolder}/modules/segger/include",
            "${workspaceFolder}/modules/stm32/include",
            "${workspaceFolder}/boards/stm32_f4ve_v2/include",
            "${workspaceFolder}/applications/unittests/include",
            "${workspaceFolder}/applications/simple/include",
            "${workspaceFolder}/applications/test-ssd1306/include",
            "${workspaceFolder}/applications/test-i2c/include",
            "${workspaceFolder}/applications/test-timers/include"
        ]
    },
    "configurations": [
        {
            "name": "Unit Tests on Homebrew LLVM",
            "includePath": [
                "${DefaultIncludePaths}"
            ],
            "defines": [],
            "compilerPath": "/opt/homebrew/Cellar/llvm/20.1.6/bin/clang++",
            "intelliSenseMode": "macos-clang-arm64",
            "cppStandard": "c++20",
            "cStandard": "c23",
            "compilerArgs": [
                "-nostdlib",
                "-mthumb",
                "-mno-thumb-interwork",
                "-mcpu=cortex-m4",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard",
                "-fsingle-precision-constant",
                "-fno-exceptions",
                "-fno-rtti"
            ],
            "compileCommands": "${workspaceFolder}/build/homebrew-llvm/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "On Target Cross Compile",
            "includePath": [
                "${DefaultIncludePaths}"
            ],
            "defines": [],
            "compilerPath": "/Applications/ArmGNUToolchain/14.2.rel1/arm-none-eabi/bin/arm-none-eabi-g++",
            "intelliSenseMode": "macos-gcc-arm",
            "cppStandard": "c++20",
            "cStandard": "c23",
            "compilerArgs": [
                "-nostdlib",
                "-mthumb",
                "-mno-thumb-interwork",
                "-mcpu=cortex-m4",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard",
                "-fsingle-precision-constant",
                "-fno-exceptions",
                "-fno-rtti"
            ],
            "compileCommands": "${workspaceFolder}/build/cortex-gcc-arm-none-eabi/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}