{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local Debug via LLDB",
            "cwd": "${workspaceRoot}",
            "type": "lldb",
            "request": "launch",
            "args": [],
            "linux": {},
            "osx": {},
        },
        {
            "name": "Cortex-Debug (JLink) On Target Tests",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/cortex-gcc-arm-none-eabi/applications/unittests/ontarget-tests-stm32-basic-stm32_f4ve_v2.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "interface": "swd",
            "runToEntryPoint": true,
            "device": "STM32F407VE",
            "internalConsoleOptions": "openOnSessionStart",
            //"internalConsoleOptions": "openOnFirstSessionStart",
            "svdFile": "${workspaceFolder}/modules/stm32/scripts/STM32F407.svd",
            //"preLaunchTask": "Build",
            "showDevDebugOutput": true,
            "preLaunchCommands": [
                "set mem inaccessible-by-default off"
            ],
            "preRestartCommands": [
                "monitor reset 0"
            ]
        },
        {
            "name": "(gdb) Jlink Spi Demo",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/cortex-gcc-arm-none-eabi/applications/simple/spi-demo-stm32-basic-stm32_f4ve_v2.elf",
            "servertype": "jlink",
            "interface": "swd",
            "runToEntryPoint": "true",
            "device": "STM32F407VE",
            "svdFile": "${workspaceFolder}/modules/stm32/scripts/STM32F407.svd",
            "internalConsoleOptions": "openOnSessionStart",
            "showDevDebugOutput": "both",
            "preLaunchCommands": [
                "set mem inaccessible-by-default off"
            ],
            "preRestartCommands": [
                "monitor reset 0"
            ]
        },
    ]
}