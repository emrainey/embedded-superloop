.zero_table ALIGN(8) : {
    __zero_table_start = . ;
    LONG(ORIGIN(ITCM))
    LONG(ORIGIN(ITCM) + LENGTH(ITCM))
    LONG(ORIGIN(DTCM))
    LONG(ORIGIN(DTCM) + LENGTH(DTCM))
    LONG(ORIGIN(AXISRAM))
    LONG(ORIGIN(AXISRAM) + LENGTH(AXISRAM))
    LONG(ORIGIN(SRAM123))
    LONG(ORIGIN(SRAM123) + LENGTH(SRAM123))
    LONG(ORIGIN(SRAM4))
    LONG(ORIGIN(SRAM4) + LENGTH(SRAM4))
    __zero_table_limit = . ;
} >FLASH
