{
    "folders": [
        {
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "ms-vscode.cmake-tools",
            "fredericbonnet.cmake-test-adapter",
            "matepek.vscode-catch2-test-adapter",
            "samuelcolvin.jinjahtml",
            "cheshirekow.cmake-format",
            "bbenoist.doxygen",
            "oderwat.indent-rainbow",
            "shd101wyy.markdown-preview-enhanced",
            "davidanson.vscode-markdownlint",
            "gruntfuggly.todo-tree",
            "xaver.clang-format",
            "llvm-vs-code-extensions.vscode-clangd",
            "ms-vscode.hexeditor"
        ],
    },
    "settings": {
        "clang-format.executable": "/opt/homebrew/bin/clang-format",
        "clang-format.fallbackStyle": "Google",
        "clang-format.style": "file",
        "clangd.arguments": [
            "--background-index",
            "--clang-tidy",
            "--compile-commands-dir=${command:cmake.buildDirectory}/",
            "--enable-config",
            "--header-insertion=iwyu",
            "--log=verbose",
            "--pretty"
        ],
        "clangd.path": "/opt/homebrew/bin/clangd",
        "cmake.allowCommentsInPresetsFile": true,
        "cmake.allowUnsupportedPresetsVersions": true,
        "cmake.buildEnvironment": {
            "CMAKE_MAKEFILE_VERBOSE": "OFF",
            "CMAKE_VERBOSE": "0",
        },
        // "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
        "cmake.deleteBuildDirOnCleanConfigure": true,
        "cmake.ignoreCMakeListsMissing": false,
        "cmake.useCMakePresets": "always",
        "cSpell.allowCompoundWords": true,
        "cSpell.dictionaries": [
            "cortex-m-registers",
            "thumb2-mnemonics",
            "vocabulary"
        ],
        "cSpell.dictionaryDefinitions": [
            {
                "name": "vocabulary",
                "path": "${workspaceFolder}/documentation/vocabulary.txt"
            },
            {
                "name": "cortex-m-registers",
                "path": "${workspaceFolder}/documentation/cortex-m-registers.txt"
            },
            {
                "name": "thumb2-mnemonics",
                "path": "${workspaceFolder}/documentation/thumb2-mnemonics.txt"
            }
        ],
        "editor.formatOnSave": true,
        "files.associations": {
            "*.cpp.jinja": "jinja-cpp",
            "*.dot.jinja": "jinja-raw",
            "*.hpp.jinja": "jinja-cpp",
            "*.in": "cpp",
            "*.inc": "cpp",
            "*.ipp": "cpp",
            "*.puml.jinja": "jinja-raw",
            "*.tcc": "cpp",
            ".clang-format": "json",
            ".clang-tidy": "yaml",
            "__availability": "cpp",
            "__bit_reference": "cpp",
            "__bits": "cpp",
            "__config": "cpp",
            "__debug": "cpp",
            "__errc": "cpp",
            "__hash_table": "cpp",
            "__locale": "cpp",
            "__mutex_base": "cpp",
            "__node_handle": "cpp",
            "__nullptr": "cpp",
            "__split_buffer": "cpp",
            "__string": "cpp",
            "__threading_support": "cpp",
            "__tree": "cpp",
            "__tuple": "cpp",
            "__verbose_abort": "cpp",
            "algorithm": "cpp",
            "any": "cpp",
            "array": "cpp",
            "atomic": "cpp",
            "bit": "cpp",
            "bitset": "cpp",
            "cassert": "cpp",
            "ccomplex": "cpp",
            "cctype": "cpp",
            "cerrno": "cpp",
            "cfloat": "cpp",
            "charconv": "cpp",
            "chrono": "cpp",
            "cinttypes": "cpp",
            "ciso646": "cpp",
            "climits": "cpp",
            "clocale": "cpp",
            "cmath": "cpp",
            "codecvt": "cpp",
            "compare": "cpp",
            "complex": "cpp",
            "concepts": "cpp",
            "condition_variable": "cpp",
            "coroutine": "cpp",
            "csignal": "cpp",
            "cstdarg": "cpp",
            "cstdbool": "cpp",
            "cstddef": "cpp",
            "cstdint": "cpp",
            "cstdio": "cpp",
            "cstdlib": "cpp",
            "cstring": "cpp",
            "ctgmath": "cpp",
            "ctime": "cpp",
            "cwchar": "cpp",
            "cwctype": "cpp",
            "deque": "cpp",
            "exception": "cpp",
            "execution": "cpp",
            "filesystem": "cpp",
            "format": "cpp",
            "forward_list": "cpp",
            "fstream": "cpp",
            "functional": "cpp",
            "future": "cpp",
            "hash_map": "cpp",
            "initializer_list": "cpp",
            "iomanip": "cpp",
            "ios": "cpp",
            "iosfwd": "cpp",
            "iostream": "cpp",
            "istream": "cpp",
            "iterator": "cpp",
            "limits": "cpp",
            "list": "cpp",
            "locale": "cpp",
            "map": "cpp",
            "memory": "cpp",
            "memory_resource": "cpp",
            "mutex": "cpp",
            "new": "cpp",
            "numbers": "cpp",
            "numeric": "cpp",
            "optional": "cpp",
            "ostream": "cpp",
            "print": "cpp",
            "queue": "cpp",
            "random": "cpp",
            "ranges": "cpp",
            "ratio": "cpp",
