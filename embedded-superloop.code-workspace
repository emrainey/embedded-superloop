{
    "folders": [
        {
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "ms-vscode.cmake-tools",
            "fredericbonnet.cmake-test-adapter",
            "matepek.vscode-catch2-test-adapter",
            "samuelcolvin.jinjahtml",
            "cheshirekow.cmake-format",
            "bbenoist.doxygen",
            "oderwat.indent-rainbow",
            "shd101wyy.markdown-preview-enhanced",
            "davidanson.vscode-markdownlint",
            "gruntfuggly.todo-tree",
            "xaver.clang-format",
            "vadimcn.vscode-lldb",
            "llvm-vs-code-extensions.vscode-clangd",
            "ms-vscode.hexeditor"
        ],
    },
    "settings": {
        "clang-format.executable": "/opt/homebrew/bin/clang-format",
        "clang-format.fallbackStyle": "Google",
        "clang-format.style": "file",
        "clangd.arguments": [
            "--background-index",
            "--clang-tidy",
            "--compile-commands-dir=${command:cmake.buildDirectory}/",
            "--enable-config",
            "--header-insertion=iwyu",
            "--log=verbose",
            "--pretty"
        ],
        "clangd.path": "/opt/homebrew/bin/clangd",
        "cmake.allowCommentsInPresetsFile": true,
        "cmake.allowUnsupportedPresetsVersions": true,
        "cmake.buildEnvironment": {
            "CMAKE_MAKEFILE_VERBOSE": "OFF",
            "CMAKE_VERBOSE": "0",
        },
        // "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
        "cmake.deleteBuildDirOnCleanConfigure": true,
        "cmake.ignoreCMakeListsMissing": false,
        "cmake.useCMakePresets": "always",
        "cSpell.allowCompoundWords": true,
        "cSpell.dictionaries": [
            "cortex-m-registers",
            "thumb2-mnemonics",
            "vocabulary"
        ],
        "cSpell.dictionaryDefinitions": [
            {
                "name": "vocabulary",
                "path": "${workspaceFolder}/documentation/vocabulary.txt"
            },
            {
                "name": "cortex-m-registers",
                "path": "${workspaceFolder}/documentation/cortex-m-registers.txt"
            },
            {
                "name": "thumb2-mnemonics",
                "path": "${workspaceFolder}/documentation/thumb2-mnemonics.txt"
            }
        ],
        "editor.formatOnSave": true,
        "files.associations": {
            "*.cpp.jinja": "jinja-cpp",
            "*.dot.jinja": "jinja-raw",
            "*.hpp.jinja": "jinja-cpp",
            "*.in": "cpp",
            "*.inc": "cpp",
            "*.ipp": "cpp",
            "*.puml.jinja": "jinja-raw",
            "*.tcc": "cpp",
            ".clang-format": "json",
