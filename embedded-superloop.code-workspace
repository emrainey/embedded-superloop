            "thread": "cpp",
            "tuple": "cpp",
            "type_traits": "cpp",
            "typeindex": "cpp",
            "typeinfo": "cpp",
            "unordered_map": "cpp",
            "unordered_set": "cpp",
            "utility": "cpp",
            "variant": "cpp",
            "vector": "cpp",
            "version": "cpp"
        },
        "python.analysis.autoFormatStrings": true,
        "python.analysis.typeCheckingMode": "strict",
        "python.defaultInterpreterPath": "${command:cmake.buildDirectory}/venv/bin/python3",
        "testMate.cpp.test.executables": "${command:cmake.buildDirectory}/**/test-*",
        "testMate.cpp.test.parallelExecutionLimit": 2,
        "testMate.cpp.test.parallelExecutionOfExecutableLimit": 2,
        "cSpell.words": [
            "distcc"
        ],
        "cmake.configureOnOpen": false
    }
}